{
  "name": "securescope",
  "version": "1.0.0",
  "description": "SecureScope — Desktop Website Security Assessment Platform",
  "main": "dist-electron/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build --config apps/desktop/vite.config.ts",
    "build:electron": "tsc -p apps/desktop/tsconfig.electron.json",
    "build": "npm run build:electron && npm run build:renderer",
    "test:foundation": "node scripts/verify-foundation.js",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.renderer.json && tsc --noEmit -p apps/desktop/tsconfig.electron.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
